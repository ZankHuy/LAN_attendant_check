# CheckNV — biến môi trường mẫu
# Copy file này thành `.env` và điền giá trị thực khi deploy.
#
# Lưu ý: với docker-compose, các biến này có thể set trực tiếp trong
# file docker-compose.yml dưới khóa `environment:`. Nếu dùng `.env`,
# docker-compose tự load từ đường dẫn mặc định.

# ── Múi giờ ────────────────────────────────────────────────────────────────
TZ=Asia/Ho_Chi_Minh

# ── Đường dẫn log ──────────────────────────────────────────────────────────
# Thư mục chứa file app.log (mặc định: ./data)
# LOG_DIR=data

# ── Trang Hidden (chỉnh sửa chấm công) ────────────────────────────────────
# URL path cho trang hidden. Mặc định: /hidden
# HIDDEN_URL_PATH=hidden
#
# Mật khẩu truy cập trang hidden.
# BẮT BUỘC set giá trị để bật trang. Nếu để trống, /api/hidden/* trả 404.
# HIDDEN_PASSWORD=changeme

# ── Xuất Excel ────────────────────────────────────────────────────────────
# Tên file Excel template dưới ./resorce/. Mặc định: template.xlsx
# EXPORT_TEMPLATE_FILE=template.xlsx