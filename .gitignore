# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Distribution / packaging
build/
dist/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
data/app.log

# Runtime data (SQLite DB, WAL files, operator-only)
data/checknv.db
data/checknv.db-journal
data/checknv.db-wal
data/checknv.db-shm
backups/

# Local-only symlinks / copies created during local testing (mirror the
# container layout so uvicorn can find static/, resorce/, data/).
# These paths should NOT be committed — the canonical copies live at the
# repo root and are mounted into the container at build time.
app/data/
app/static/
app/resorce/

# Local test artefacts (kept out of the repo).
test_out_*.xlsx
scripts/debug_*.py

# Secrets / env overrides (the .env.example file IS tracked)
.env
.env.*
!.env.example

# Excel templates (operator-supplied via Docker volume or env var)
resorce/*.xlsx
resorce/*.xls
!resorce/README.md

# Backups / scratch
*.bak
*.tmp
*.orig

# Operational runbook (kept out of git to keep repo lean for new operators;
# re-add if you want to publish it on GitHub.)
HUONG-DAN-VAN-HANH.md

# Local smoke-test outputs (created by scripts/test_*.py)
test_out_*.xlsx

# One-off debug scripts (kept out of git; reproduce by hand if needed)
scripts/debug_*.py

# Data directory runtime artefacts that may sneak in (gitignore above
# already covers data/, but be explicit about the files people copy in)
data/app.log
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
app/data/*.db
app/data/*.log
app/resorce/*.xlsx
app/resorce/*.xls
